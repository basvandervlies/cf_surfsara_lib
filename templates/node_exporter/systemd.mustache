### Controlled by CFEngine3
#   template file: {{{vars.scl.template_file}}}
#   files: {{{vars.scl.json_files}}}
[Unit]
Description=Prometheus exporter for machine metrics
Documentation=https://github.com/prometheus/node_exporter

[Service]
Restart=always
EnvironmentFile=/etc/default/node_exporter
ExecStartPre=-/bin/mkdir -p {{{vars.scl.node_exporter.collector_dir}}}
ExecStart={{{vars.scl.node_exporter.dir}}}/node_exporter $ARGS
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=20s
SendSIGKILL=no

[Install]
WantedBy=multi-user.target
