#
## openssl.cf @SURF
#
bundle common openssl
{
    vars:
        any::
            "template_2_destination" data => parsejson('
                {
                    "openssl.cnf.$(sys.flavour).mustache" : "$(file)",
                }
            ');

        debian|centos::
            "dir"               string => "/etc/ssl";
            "file"              string => "$(dir)/openssl.cnf";
            "owner"             string => "root";
            "group"             string => "root";
            "mode"              string => "0644";
}

bundle agent openssl_autorun()
{
    meta:
        "tags" slist => { "service_openssl", "template_openssl" };

    methods:
        any::
            "" usebundle => openssl_install();
            "" usebundle => openssl_config();

    reports:
        DEBUG_openssl::
            "$(this.bundle): surf openssl template run";
}

bundle agent openssl_install()
{
    vars:

        debian|centos::
            "packages" data => parsejson('
                {
                    "install": {
                        "openssl": "",
                    }
                }
            ');

    methods:
        any::
            "" usebundle => scl_service_packages("openssl", "@(openssl_install.packages)");
}

bundle agent openssl_config()
{
    vars:

    methods:
        any::
            "" usebundle => scl_mustache_autorun("openssl");

    files:

    reports:
        any::
            "$(this.bundle): $(openssl.file) file has changed"
               if => or(
                   canonify("scl$(openssl.file)")
               ); 

}
@if minimum_version(99.9)
# OPENSSL

Source: [openssl.cf](/services/openssl.cf)

This bundle will generate this file from mustache template:
 * /etc/ssl/openssl.cnf


These files will be generated with the aid of mustache templates with json data.
the templates are located in:
 * templates/openssl/
 * templates/openssl/json

## USAGE

The bundle can be run via:
 * `def.scl_services_enabled`
```json
"vars": {
    "scl_services_enabled": [
            "...",
            "openssl",
            "..."
    ]
}
```

The bundle will always read the [default.json](/templates/openssl/json/default.json) file
and extra json file(s) can be specified via:
 * def.cf
```
vars:
    any::
        "openssl_json_files" slist => { "liza.json" };
```

The variable must be ''openssl_json_files'' and with this setup 1 extra json file will be merged.

### DEBUG

If you want to debug these bundle set the `DEBUG_openssl` class, eg:
 * `-DDEBUG_openssl`

##  def.cf/json

See [default.json](/templates/openssl/json/default.json) what the default values are and
which variables can be overriden.

Here are some examples how to use it:
 * specify openssl configuration in def.cf:
```
vars:
    "openssl_json_files" slist => { "liza.json" };
```
@endif
