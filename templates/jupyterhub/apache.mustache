<VirtualHost {{{server_name}}}:443>

    ServerName {{{server_name}}}

    # configure SSL
    SSLEngine on
    SSLCertificateFile /etc/certificate/certificate.pem
    SSLCertificateKeyFile /etc/certificate/private_key.pem

    ### Loop over the jupyterhub configs
    #
    {{#hubs}}
    <Location "/{{@}}">
        RewriteEngine On
        RewriteCond %{HTTP:Connection} Upgrade [NC]
        RewriteCond %{HTTP:Upgrade} websocket [NC]
        RewriteRule /{{@}}/(.*) {{config_default.url_ws}}{{.number}}/{{@}}/$1 [{{{apache_rewriterule_flags}}}]
        RewriteRule /{{@}}/(.*) {{config_default.url_bind}}{{.number}}/{{@}}/$1 [{{{apache_rewriterule_flags}}}]

        # preserve Host header to avoid cross-origin problems
        ProxyPreserveHost on
        # proxy to JupyterHub
        ProxyPass         {{config_default.url_bind}}{{.number}}/{{@}}
        ProxyPassReverse  {{config_default.url_bind}}{{.number}}/{{@}}

    </Location>
    {{/hubs}}
</VirtualHost>
